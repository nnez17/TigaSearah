{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node"],
		"lib": ["ES2022", "DOM"],
		"baseUrl": ".",
		"paths": {
			"@tiga-searah/shared/*": ["../../packages/shared/*"],
			"@tiga-searah/shared": ["../../packages/shared/contact.ts"]
		}
	},
	"include": ["server/**/*.ts", "nitro.config.ts"]
}
