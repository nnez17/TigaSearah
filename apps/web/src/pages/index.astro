---
import ContactForm from "../components/ContactForm";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Icon from "../components/Icon.astro";
import { projects } from "../data/projects";
import Layout from "../layouts/Layout.astro";

const services = [
  {
    number: "01",
    name: "Website Development",
    description:
      "Rumah digital yang merepresentasikan bisnismu. Cepat, responsif, dan dibuat untuk tujuan yang jelas.",
    tags: ["Company profile", "Landing page", "Portfolio website"],
    icon: "globe" as const,
  },
  {
    number: "02",
    name: "Web Application",
    description:
      "Ubah proses yang rumit menjadi aplikasi yang berguna. Fitur dibangun mengikuti kebutuhan penggunamu.",
    tags: ["Dashboard", "Internal portal", "Custom application"],
    icon: "code" as const,
  },
  {
    number: "03",
    name: "Backend & API Integration",
    description:
      "Fondasi di balik pengalaman digital. Data, logika bisnis, dan integrasi yang saling terhubung.",
    tags: ["REST API", "Database", "Service integration"],
    icon: "layers" as const,
  },
];
const stages = [
  ["Discover", "Kenali kebutuhan, pengguna, dan tujuan yang ingin kamu capai."],
  ["Define", "Sepakati ruang lingkup, prioritas, estimasi, dan hasil akhir."],
  ["Design", "Rangkai alur dan visual menjadi pengalaman yang masuk akal."],
  ["Develop", "Bangun, integrasikan, dan uji setiap bagian produk."],
  ["Deliver", "Tinjau bersama, selesaikan revisi, dan siapkan serah terima."],
];
const stepColors = [
  "bg-blue-600 shadow-[0_3px_0_#1d4ed8]",
  "bg-purple-600 shadow-[0_3px_0_#6d28d9]",
  "bg-pink-600 shadow-[0_3px_0_#be185d]",
  "bg-emerald-600 shadow-[0_3px_0_#047857]",
  "bg-amber-500 shadow-[0_3px_0_#b45309]",
];
const faqs = [
  [
    "Layanan apa saja yang tersedia?",
    "Kami membantu pengembangan website, aplikasi web, serta backend dan integrasi API. Pilih layanan pada formulir, atau ceritakan idemu jika belum yakin.",
  ],
  [
    "Bagaimana cara memulai proyek?",
    "Isi formulir di bawah dengan gambaran kebutuhanmu atau kirim email ke trio.searah@gmail.com. Kami akan membahas tujuan, ruang lingkup, dan langkah berikutnya bersama.",
  ],
  [
    "Berapa biaya pembuatan website?",
    "Biaya mengikuti kebutuhan desain, jumlah halaman, fitur, dan integrasi. Estimasi disusun setelah ruang lingkup dipahami. Belum punya anggaran pasti? Kita bisa mendiskusikan prioritas lebih dahulu.",
  ],
  [
    "Berapa lama proses pengerjaannya?",
    "Durasi bergantung pada kompleksitas, kesiapan konten, dan proses peninjauan. Jadwal dan milestone disepakati setelah kebutuhan jelas. Perubahan ruang lingkup bisa memengaruhi waktu dan biaya.",
  ],
  [
    "Bisa mengerjakan proyek dengan kebutuhan khusus?",
    "Bisa dibahas. Ceritakan masalah dan fitur yang kamu butuhkan; kami akan menilai kesesuaian kemampuan, integrasi, serta ruang lingkup sebelum menyepakati proyek.",
  ],
  [
    "Apakah website bisa dikembangkan lagi?",
    "Pengembangan lanjutan dapat direncanakan sesuai struktur dan kebutuhan website. Sampaikan rencana jangka panjang sejak awal agar pilihan teknis dapat mempertimbangkannya.",
  ],
  [
    "Bagaimana ketentuan revisi dan serah terima?",
    "Jumlah revisi, materi yang diserahkan, akses, serta dokumentasi disepakati dalam ruang lingkup proyek. Kebutuhan di luar kesepakatan dibahas sebagai perubahan ruang lingkup.",
  ],
  [
    "Apakah tersedia layanan maintenance?",
    "Dukungan setelah peluncuran dapat dibahas sesuai kebutuhan dan kapasitas tim. Cakupan, periode, dan biaya maintenance perlu disepakati secara terpisah.",
  ],
];
---

<Layout>
  <div id="top"></div>
  <Header />
  <main id="main">
    <section
      class="hero relative overflow-hidden flex flex-col justify-center min-h-[calc(100svh-76px)] md:min-h-[calc(100svh-88px)]"
      aria-labelledby="hero-title"
    >
      <div class="hero-backdrop hero-visual">
        <noscript>
          <img
            class="scene-fallback absolute w-full h-full inset-0 object-contain object-[72%_46%]"
            src="/images/direction-fallback.svg"
            width="660"
            height="640"
            alt=""
          />
        </noscript>
        <canvas id="direction-scene" aria-hidden="true"></canvas>
      </div>
      <div class="container hero-content relative z-2 py-10">
        <h1
          id="hero-title"
          class="font-display font-bold text-4xl sm:text-5xl md:text-6xl tracking-tight leading-[1.08]"
        >
          Different minds.<br /><span
            class="direction-word text-blue [text-shadow:0_0_30px_rgba(162,200,255,0.25)]"
            >One direction.</span
          >
          <span
            class="headline-star inline-block text-blue ml-5 text-[0.7em] align-[5%]"
            aria-hidden="true">↗</span
          >
        </h1>
        <div
          class="hero-main grid grid-cols-1 md:grid-cols-[minmax(0,0.95fr)_minmax(0,1fr)] items-center gap-10 md:gap-16 my-7 mb-5"
        >
          <div class="hero-copy py-2">
            <p
              class="hero-tagline font-display text-xl sm:text-[22px] font-bold tracking-tight text-text"
            >
              Beda Ayah, Satu Arah.
            </p>
            <p
              class="hero-description text-muted text-sm leading-relaxed max-w-[400px] mt-3.5"
            >
              Tiga keahlian. Satu tim. Kami merancang dan membangun website yang
              membantu idemu menemukan bentuk terbaiknya.
            </p>
            <div class="hero-actions flex items-center gap-5 mt-7 flex-wrap">
              <a
                class="inline-flex items-center justify-between gap-5 min-h-[50px] px-6 py-3 text-[13px] font-bold rounded-2xl select-none cursor-pointer text-white bg-blue-600 border-2 border-blue-500 shadow-[0_4px_0_#1d4ed8,0_6px_18px_rgba(37,99,235,0.35)] hover:bg-blue-500 hover:border-blue-400 active:translate-y-[3px] active:shadow-[0_1px_0_#1d4ed8] transition-all"
                href="#contact">Mulai proyekmu <Icon /></a
              ><a
                class="inline-flex items-center gap-2.5 text-[13px] font-bold text-slate-300 hover:text-blue-400 [.light-theme_&]:text-slate-600 [.light-theme_&]:hover:text-blue-600 transition-colors"
                href="#work"
                >Jelajahi karya <Icon name="arrow-right" size={18} /></a
              >
            </div>
            <div
              class="hero-chips flex flex-wrap gap-2.5 mt-7 pt-5.5 border-t border-white/[0.08] [.light-theme_&]:border-slate-200 max-w-[480px]"
            >
              <span
                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-slate-200 [.light-theme_&]:text-slate-700 bg-white/[0.04] [.light-theme_&]:bg-white border border-white/10 [.light-theme_&]:border-slate-300 rounded-full shadow-[0_2px_0_rgba(0,0,0,0.25)] hover:border-blue-400/40 hover:bg-blue-600/10 hover:text-white transition-all"
                >Website Development</span
              >
              <span
                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-slate-200 [.light-theme_&]:text-slate-700 bg-white/[0.04] [.light-theme_&]:bg-white border border-white/10 [.light-theme_&]:border-slate-300 rounded-full shadow-[0_2px_0_rgba(0,0,0,0.25)] hover:border-blue-400/40 hover:bg-blue-600/10 hover:text-white transition-all"
                >Web Applications</span
              >
              <span
                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-slate-200 [.light-theme_&]:text-slate-700 bg-white/[0.04] [.light-theme_&]:bg-white border border-white/10 [.light-theme_&]:border-slate-300 rounded-full shadow-[0_2px_0_rgba(0,0,0,0.25)] hover:border-blue-400/40 hover:bg-blue-600/10 hover:text-white transition-all"
                >API & Integrasi</span
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="work"
      class="section work-section relative py-20 md:py-24 scroll-mt-2.5 bg-[#0d0f15] [.light-theme_&]:bg-slate-100/70 border-t border-white/[0.06] [.light-theme_&]:border-slate-200"
    >
      <div class="container">
        <div
          class="section-heading-row flex flex-col md:flex-row md:items-end justify-between gap-6 md:gap-10 mb-11"
        >
          <h2
            class="text-3xl sm:text-4xl md:text-5xl font-bold font-display text-text"
          >
            Karya nyata.<br /><span class="serif-word text-blue"
              >Cerita berbeda.</span
            >
          </h2><div>
            <p
              class="text-muted text-xs sm:text-[13px] max-w-[360px] leading-relaxed"
            >
              Dari ruang kelas hingga ruang aspirasi.<br />Produk digital yang
              kami bangun bersama.
            </p><a
              class="inline-flex items-center gap-2 mt-4 text-[13px] font-bold text-slate-300 hover:text-blue-400 [.light-theme_&]:text-slate-600 [.light-theme_&]:hover:text-blue-600 transition-colors"
              href="https://github.com/tiga-searah"
              target="_blank"
              rel="noopener noreferrer"
              >Eksplorasi GitHub kami <Icon size={18} /></a
            >
          </div>
        </div>
        <div class="work-grid grid grid-cols-1 md:grid-cols-2 gap-8">
          {
            projects.map((project, index) => (
              <article class="project-card">
                <a
                  class={`project-art project-${project.theme}`}
                  href={`/work/${project.slug}/`}
                  aria-label={`Lihat studi kasus ${project.name}`}
                >
                  <span class="work-view absolute z-4 right-5.5 top-5 w-10 h-10 border border-white/20 rounded-full grid place-items-center text-white bg-[#111318]/65 backdrop-blur-md transition-all">
                    <Icon size={23} />
                  </span>
                  <div class="project-desktop absolute z-2 left-[6%] top-[76px] w-[82%] rounded-[10px] overflow-hidden border border-white/12 shadow-[0_30px_60px_rgba(0,0,0,0.7)] -rotate-[3.5deg] [.light-theme_&]:border-slate-200 [.light-theme_&]:shadow-xl">
                    <>
                      <div
                        class="browser-top flex items-center gap-1.5 px-3.5 py-2.5 bg-[#131720] [.light-theme_&]:bg-slate-200 border-b border-white/[0.08] [.light-theme_&]:border-slate-300 text-slate-400"
                        aria-hidden="true"
                      >
                        <>
                          <i class="w-[7px] h-[7px] rounded-full bg-[#ff5f56] shadow-[0_0_6px_rgba(255,95,86,0.4)] inline-block" />
                          <i class="w-[7px] h-[7px] rounded-full bg-[#ffbd2e] shadow-[0_0_6px_rgba(255,189,46,0.4)] inline-block" />
                          <i class="w-[7px] h-[7px] rounded-full bg-[#27c93f] shadow-[0_0_6px_rgba(39,201,63,0.4)] inline-block" />
                          <span class="font-display flex-1 text-center text-[8px] tracking-wider text-slate-400">
                            {new URL(project.live).hostname}
                          </span>
                        </>
                      </div>
                      <img
                        src={project.image}
                        width={project.width}
                        height={project.height}
                        alt={`Screenshot asli website ${project.name}`}
                        loading="lazy"
                        class="w-full h-auto"
                      />
                    </>
                  </div>
                  <img
                    class="project-mobile absolute z-3 w-[22%] h-auto right-[5%] top-[145px] border-[5px] border-[#161b24] [.light-theme_&]:border-slate-800 rounded-[18px] shadow-[0_0_0_1px_rgba(255,255,255,0.16),0_25px_50px_rgba(0,0,0,0.75)] rotate-[5.5deg]"
                    src={project.mobileImage}
                    width="380"
                    height="844"
                    alt=""
                    loading="lazy"
                  />
                </a>
                <div class="project-meta pt-6">
                  <div class="project-pill-row flex items-center gap-2.5 mb-2.5">
                    <span
                      class={`project-category-chip inline-flex items-center px-3 py-1 rounded-full text-[11px] font-bold shadow-[0_2px_0_rgba(0,0,0,0.25)] ${project.theme === "sky" ? "bg-sky-400/15 border border-sky-400 text-sky-300" : "bg-indigo-400/15 border border-indigo-400 text-indigo-300"}`}
                    >
                      {project.category}
                    </span>
                    <span class="project-num-badge inline-flex items-center px-2.5 py-0.5 rounded-full bg-white/[0.06] border border-white/12 text-slate-400 text-[11px] font-bold">
                      #{index + 1}
                    </span>
                  </div>
                  <h3 class="text-[22px] font-bold mt-2 text-white [.light-theme_&]:text-slate-900">
                    <a
                      class="flex justify-between items-center gap-5 hover:text-blue transition-colors"
                      href={`/work/${project.slug}/`}
                    >
                      {project.name} <Icon size={25} />
                    </a>
                  </h3>
                  <p class="text-slate-400 [.light-theme_&]:text-slate-600 text-[13px] leading-relaxed mt-2">
                    {project.summary}
                  </p>
                  <div class="project-links flex gap-3 mt-5 flex-wrap">
                    <a
                      class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-white/[0.04] border border-white/[0.12] text-slate-200 shadow-[0_3px_0_rgba(0,0,0,0.3)] hover:border-blue-400 hover:text-blue-300 hover:bg-blue-600/10 active:translate-y-[2px] active:shadow-[0_1px_0_rgba(0,0,0,0.4)] transition-all [.light-theme_&]:bg-white [.light-theme_&]:border-slate-300 [.light-theme_&]:text-slate-800 [.light-theme_&]:shadow-sm [.light-theme_&]:hover:border-blue-600 [.light-theme_&]:hover:text-blue-600"
                      href={project.live}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Live website <Icon size={15} />
                    </a>
                    <a
                      class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-white/[0.04] border border-white/[0.12] text-slate-200 shadow-[0_3px_0_rgba(0,0,0,0.3)] hover:border-blue-400 hover:text-blue-300 hover:bg-blue-600/10 active:translate-y-[2px] active:shadow-[0_1px_0_rgba(0,0,0,0.4)] transition-all [.light-theme_&]:bg-white [.light-theme_&]:border-slate-300 [.light-theme_&]:text-slate-800 [.light-theme_&]:shadow-sm [.light-theme_&]:hover:border-blue-600 [.light-theme_&]:hover:text-blue-600"
                      href={project.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Repository <Icon size={15} />
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
        <a
          class="work-preview studio-project mt-12 bg-gradient-to-br from-blue-600/10 to-white/[0.02] border-2 border-white/[0.09] [.light-theme_&]:border-slate-200 [.light-theme_&]:from-blue-50 [.light-theme_&]:to-white rounded-[20px] p-7 sm:px-9 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 shadow-[0_5px_0_rgba(0,0,0,0.3)] hover:border-blue-400/40 transition-colors"
          href="/work/tiga-searah/"
          ><span
            ><strong
              class="block font-display text-lg sm:text-xl font-bold tracking-tight text-white [.light-theme_&]:text-slate-900"
              >Tiga Searah — Digital Studio</strong
            ><span
              class="text-slate-400 [.light-theme_&]:text-slate-600 text-xs sm:text-[13px] block mt-1"
              >Rumah digital kami. Astro, Three.js, dan satu arah.</span
            ></span
          ><span
            class="studio-project-link sm:ml-auto text-[13px] flex gap-2.5 items-center text-blue-400 font-bold"
            >Lihat studi kasus <Icon size={22} /></span
          ></a
        >
      </div>
    </section>

    <section
      id="services"
      class="section services-section py-20 md:py-24 scroll-mt-2.5"
    >
      <div class="container">
        <div
          class="services-layout grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-12 lg:gap-20"
        >
          <div class="section-intro">
            <h2
              class="text-3xl sm:text-4xl md:text-5xl font-bold font-display text-text"
            >
              Dari ide.<br />Jadi <span class="serif-word text-blue"
                >berarti.</span
              >
            </h2><p
              class="max-w-[330px] mt-6.5 text-muted text-xs sm:text-[13px] leading-relaxed"
            >
              Website pertama, wajah baru bisnis, atau aplikasi untuk proses
              yang lebih baik. Kita mulai dari kebutuhanmu.
            </p><a
              class="inline-flex items-center gap-2 mt-6.5 text-[13px] font-bold text-slate-300 hover:text-blue-400 [.light-theme_&]:text-slate-600 [.light-theme_&]:hover:text-blue-600 transition-colors"
              href="#contact">Temukan solusi untukmu <Icon /></a
            ><div
              class="service-small-mark hidden lg:block mt-10 text-blue-400/20 text-[108px] font-display leading-none select-none"
              aria-hidden="true"
            >
              ↗
            </div>
          </div>
          <div class="service-list flex flex-col gap-4">
            {
              services.map((service, index) => (
                <details
                  class="service-item border-2 border-white/[0.08] [.light-theme_&]:border-slate-200 rounded-[20px] bg-white/[0.02] [.light-theme_&]:bg-white shadow-[0_4px_0_rgba(0,0,0,0.25)] overflow-hidden px-6 transition-colors hover:border-blue-400/35 open:bg-blue-600/[0.05] open:border-blue-400/40"
                  open={index === 0}
                >
                  <summary class="py-5.5 flex items-center gap-4.5 list-none text-text cursor-pointer select-none [&::-webkit-details-marker]:hidden">
                    <span class="service-badge w-9 h-9 rounded-xl bg-blue-600 text-white font-extrabold text-sm grid place-items-center shadow-[0_3px_0_#1d4ed8] shrink-0">
                      {index + 1}
                    </span>
                    <h3 class="text-lg sm:text-[19px] leading-snug text-white [.light-theme_&]:text-slate-900 font-bold flex-1">
                      {service.name}
                    </h3>
                    <span class="service-toggle ml-auto flex text-slate-400 transition-transform duration-300">
                      <Icon name="plus" />
                    </span>
                  </summary>
                  <div class="service-body pb-6 pl-0 sm:pl-[54px]">
                    <p class="text-slate-400 [.light-theme_&]:text-slate-600 text-[13px] leading-relaxed max-w-[440px]">
                      {service.description}
                    </p>
                    <div class="service-tags flex flex-wrap gap-2 mt-4.5">
                      {service.tags.map((tag) => (
                        <span class="bg-white/[0.04] border border-white/[0.08] rounded-full px-3 py-1 text-[11px] font-semibold text-slate-300 shadow-[0_2px_0_rgba(0,0,0,0.15)] [.light-theme_&]:bg-white [.light-theme_&]:border-slate-300 [.light-theme_&]:text-slate-700">
                          {tag}
                        </span>
                      ))}
                    </div>
                    <a
                      class="service-select inline-flex items-center gap-2 mt-5 text-[13px] text-blue-400 font-bold hover:text-blue-300 transition-colors"
                      href="#contact"
                      data-service={service.name}
                    >
                      Bahas kebutuhanmu <Icon size={17} />
                    </a>
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section
      id="about"
      class="section about-section relative py-20 md:py-24 scroll-mt-2.5 bg-[#0c0f17] [.light-theme_&]:bg-slate-50 border-y border-white/[0.06] [.light-theme_&]:border-slate-200"
    >
      <div class="container">
        <div
          class="about-top grid grid-cols-1 md:grid-cols-[1.2fr_1fr] gap-12 md:gap-24 items-center"
        >
          <h2
            class="text-3xl sm:text-4xl md:text-5xl font-bold font-display text-white [.light-theme_&]:text-slate-900"
          >
            Beda Ayah.<br /><span class="serif-word text-blue">Satu Arah.</span>
          </h2><div class="about-copy">
            <img
              src="/images/tiga-searah.webp"
              width="104"
              height="104"
              alt="Logo resmi Tiga Searah"
              loading="lazy"
              class="w-[76px] h-[76px] mb-5.5 rounded-[20px] border-2 border-white/12 [.light-theme_&]:border-slate-200 p-1 bg-white/[0.03] shadow-lg"
            /><p
              class="text-slate-400 [.light-theme_&]:text-slate-600 text-sm leading-relaxed max-w-[400px]"
            >
              Beda kepala, beda keahlian. Justru di situ kekuatan kami.
              Perencanaan, pengalaman pengguna, dan pengembangan bertemu dalam
              satu proses yang terhubung.
            </p><p
              class="about-tagline text-white [.light-theme_&]:text-slate-900 font-display text-lg font-bold mt-5 tracking-tight"
            >
              Three roles. One collective.
            </p>
          </div>
        </div>
        <div class="team-roles grid grid-cols-1 md:grid-cols-3 gap-7 mt-16">
          <article
            class="bg-white/[0.025] border-2 border-white/[0.08] [.light-theme_&]:bg-white [.light-theme_&]:border-slate-200 rounded-[20px] p-7 sm:p-8 shadow-[0_5px_0_rgba(0,0,0,0.3)] backdrop-blur-md hover:border-blue-400/40 transition-colors"
          >
            <span
              class="role-symbol inline-block text-[32px] font-display text-blue-400 mb-4 leading-none"
              aria-hidden="true">↗</span
            ><h3
              class="text-xl font-bold text-white [.light-theme_&]:text-slate-900 mb-1"
            >
              Project Management
            </h3><p
              class="text-sm font-semibold text-blue-400 [.light-theme_&]:text-blue-600 mb-3 font-display"
            >
              Fayakun Achmad Isa
            </p><p
              class="text-slate-400 [.light-theme_&]:text-slate-600 text-[13px] leading-relaxed max-w-[310px]"
            >
              Merangkum kebutuhan, menentukan prioritas, dan menjaga komunikasi
              agar setiap langkah punya arah.
            </p>
          </article><article
            class="bg-white/[0.025] border-2 border-white/[0.08] [.light-theme_&]:bg-white [.light-theme_&]:border-slate-200 rounded-[20px] p-7 sm:p-8 shadow-[0_5px_0_rgba(0,0,0,0.3)] backdrop-blur-md hover:border-blue-400/40 transition-colors"
          >
            <span
              class="role-symbol inline-block text-[32px] font-display text-blue-400 mb-4 leading-none"
              aria-hidden="true">↗</span
            ><h3
              class="text-xl font-bold text-white [.light-theme_&]:text-slate-900 mb-1"
            >
              Frontend Development
            </h3><p
