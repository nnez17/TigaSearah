<script>
  document
    .querySelectorAll<HTMLAnchorElement>("[data-service]")
    .forEach((link) => {
      link.addEventListener("click", () => {
        const service = link.dataset.service;
        const url = new URL(location.href);
        url.searchParams.set("service", service || "");
        history.replaceState(null, "", url);
        window.dispatchEvent(
          new CustomEvent("select-service", { detail: service }),
        );
      });
    });
  const visual = document.querySelector<HTMLElement>(".hero-visual");
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  const connection = (
    navigator as Navigator & { connection?: { saveData?: boolean } }
  ).connection;
  const deviceMemory = (navigator as Navigator & { deviceMemory?: number })
    .deviceMemory;
  if (
    visual &&
    matchMedia("(min-width: 768px)").matches &&
    !reducedMotion.matches &&
    !connection?.saveData &&
    (!deviceMemory || deviceMemory > 2)
  ) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          observer.disconnect();
          import("../scripts/direction-scene")
            .then(({ mountScene }) => mountScene(visual))
            .catch(() => {
              /* Static artwork remains available. */
            });
        }
      },
      { rootMargin: "100px" },
    );
    observer.observe(visual);
  }
</script>
