---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Icon from "../../components/Icon.astro";
import { projects } from "../../data/projects";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
---

<Layout
  title={`${project.name} — Karya Tiga Searah`}
  description={project.summary}
>
  <div id="top"></div><Header />
  <main id="main" class="document-page container">
    <a class="text-link case-back" href="/#work"
      ><Icon name="arrow-right" size={18} /> Kembali ke karya</a
    >
    <div class="case-eyebrow-row">
      <span class="badge-pill">Karya Pilihan</span>
      <span class="badge-category">{project.category}</span>
    </div>
    <h1>{project.name}<span class="case-title-dot">.</span></h1>
    <p class="document-lead">{project.summary}</p>
    <div class="document-actions">
      <a
        class="button button-blue"
        href={project.live}
        target="_blank"
        rel="noopener noreferrer">Kunjungi website <Icon /></a
      ><a
        class="text-link"
        href={project.repo}
        target="_blank"
        rel="noopener noreferrer">Lihat repositori <Icon size={18} /></a
      >
    </div>
    <div class={`case-showcase project-${project.theme}`}>
      <img
        class="case-desktop"
        src={project.image}
        width={project.width}
        height={project.height}
        alt={`Screenshot asli halaman utama ${project.name}`}
      /><img
        class="case-mobile"
        src={project.mobileImage}
        width="380"
        height="844"
        alt={`Tampilan ${project.name} di ponsel`}
        loading="lazy"
      />
    </div>
    <div class="case-story">
      <div class="case-sidebar">
        <span class="mono">PROJECT NOTES</span>
        <h2>Ide, proses,<br />dan hasilnya.</h2><p>
          Proyek publik Tiga Searah.<br />Ditinjau 15 Oktober 2026.
        </p><div class="work-tags">
          {project.tech.map((tech) => <span>{tech}</span>)}
        </div>
      </div><div class="document-content">
        <h2>Tantangan</h2><p>{project.problem}</p><h2>Solusi</h2><p>
          {project.solution}
        </p><h2>Kontribusi Tiga Searah</h2><p>{project.contribution}</p><h2>
          Tentang screenshot
        </h2><p>
          Screenshot diambil langsung dari website publik pada 15 Oktober 2026.
          Tampilan dan konten situs dapat berubah setelah tanggal tersebut.
        </p>
      </div>
    </div>
    <div class="document-actions">
      <a class="button button-blue" href="/#contact"
        >Punya kebutuhan serupa? <Icon /></a
      ><a class="text-link" href="/#work">Lihat karya lainnya <Icon /></a>
    </div>
  </main><Footer />
</Layout>
