---
import Icon from "./Icon.astro";

const links = [
	["Services", "services"],
	["Work", "work"],
	["Process", "process"],
	["About", "about"],
	["Contact", "contact"],
];
const isHome = Astro.url.pathname === "/";
const home = isHome ? "" : "/";
const getHref = (id: string) => (id.startsWith("/") ? id : `${home}#${id}`);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Tiga Searah — beranda">
      <img src="/images/tiga-searah.webp" alt="" width="52" height="52" fetchpriority="high" />
      <span>Tiga Searah<span class="brand-dot">●</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Navigasi utama">
      {links.map(([label, id]) => <a href={getHref(id)}>{label}</a>)}
    </nav>
    <div class="header-actions">
      <button class="theme-toggle" type="button" aria-label="Ganti mode terang/gelap" title="Ganti mode tampilan">
        <span class="icon-sun" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
        </span>
        <span class="icon-moon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </span>
      </button>
      <a class="nav-cta" href={`${home}#contact`}>Mulai proyek <Icon size={17} /></a>
      <button class="menu-toggle" aria-label="Buka menu" aria-expanded="false" aria-controls="mobile-nav"><span class="menu-open"><Icon name="menu" size={24} /></span><span class="menu-close"><Icon name="close" size={24} /></span></button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav container" aria-label="Navigasi seluler" hidden>
    {links.map(([label, id], i) => <a href={getHref(id)}><span class="mono">0{i + 1}</span>{label}<Icon /></a>)}
    <button class="mobile-theme-row theme-toggle" type="button" aria-label="Ganti mode tampilan">
      <span class="mono">TEMA</span>
      <span class="mobile-theme-text">Ganti Mode Tampilan</span>
      <span class="mobile-theme-icons">
        <span class="icon-sun" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
        </span>
        <span class="icon-moon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </span>
      </span>
    </button>
    <a href={`${home}#contact`} class="mobile-start">Mulai proyek <Icon /></a>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-nav');
  function closeMenu() {
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Buka menu');
    if (menu) menu.hidden = true;
  }
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
    if (menu) menu.hidden = !open;
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
  matchMedia('(min-width: 900px)').addEventListener('change', (event) => { if (event.matches) closeMenu(); });
  // The bar is transparent over the hero and only gains a background once the page has
  // scrolled past it, so the trident reads through it at rest.
  const header = document.querySelector('.site-header');
  const pinned = () => header?.classList.toggle('is-pinned', scrollY > 24);
  pinned();
  addEventListener('scroll', pinned, { passive: true });
</script>
