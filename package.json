{
	"name": "tiga-searah",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.3",
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"dev": "bun run --parallel --filter '@tiga-searah/*' dev",
		"build": "bun run --filter @tiga-searah/web build && bun run --filter @tiga-searah/api build",
		"start": "bun apps/api/.output/server/index.mjs",
		"check": "bun run --filter @tiga-searah/web check && tsc --noEmit -p apps/api/tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"format": "bunx biome format --write",
		"lint": "bunx biome check --write"
	},
	"dependencies": {
		"zod": "^4.1.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "^1.55.0",
		"@types/node": "^22.18.0",
		"gifenc": "^1.0.3",
		"lighthouse": "^13.5.0",
		"typescript": "^5.9.2",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"sharp": "^0.35.5",
		"esbuild": "^0.28.1",
		"tinypool": "^2.1.2"
	}
}
